# Python runtime + build artifacts. The sidecar runs under uv-managed
# venvs in dev and inside a container image in prod — neither needs to
# track build droppings.

# Bytecode / caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Editable-install / packaging metadata (regenerated by `pip install -e .`
# or `uv pip install -e .`)
*.egg-info/
*.egg
build/
dist/
.eggs/
pip-wheel-metadata/

# Local venvs (uv default + common alternatives)
.venv/
venv/
.env/

# Pytest / mypy / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Downloaded model weights — kept in the runtime data dir, not the repo.
# (The container's /voices is bind-mounted from ~/.faceplate/sidecar/voices.)
voices/
models/

# Local env overrides
.env.local
.env.local.*
